
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://rpc.ankr.com/stellar_soroban
NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

NEXT_PUBLIC_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_TESTNET_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Reference WASM hashes are read from contracts/wasm-manifest.json served via
# the /api/wasm-manifest endpoint. No env var needed — the manifest is checked
# in and automatically served to the frontend.

# ---------------------------------------------------------------------------
# Mercury Indexer — SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# These variables are intentionally NOT prefixed with NEXT_PUBLIC_.
# Next.js inlines every NEXT_PUBLIC_* value into the client bundle at build
# time, making it readable by anyone with browser devtools.  The auth token
# is an API credential and must never reach the browser.
#
# The API route (app/api/tokens/recent/route.ts) reads MERCURY_AUTH_TOKEN on
# the server and proxies results to the client — the token itself is never
# forwarded.  Client-side code (fetchTransactionHistory, fetchAccountOperations)
# uses the Soroban RPC fallback and does not need or read these variables.
#
# If omitted, all Mercury-backed features degrade gracefully to the RPC path.
MERCURY_AUTH_TOKEN=
MERCURY_TESTNET_URL=https://testnet.mercurydata.app/rest
MERCURY_MAINNET_URL=https://mainnet.mercurydata.app/rest

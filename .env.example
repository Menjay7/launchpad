# Stellar Network Configuration
# Horizon API endpoint for account and transaction queries
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ---------------------------------------------------------------------------
# Mercury Indexer — SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# These variables are intentionally NOT prefixed with NEXT_PUBLIC_.
# Next.js inlines every NEXT_PUBLIC_* value into the client bundle at build
# time, making it readable by anyone with browser devtools. The auth token
# is an API credential and must never reach the browser.
#
# The API route (frontend/app/api/tokens/recent/route.ts) reads
# MERCURY_AUTH_TOKEN on the server and proxies results to the client — the
# token itself is never forwarded. Client-side code uses the Soroban RPC
# fallback and does not need or read these variables.
#
# If omitted, all Mercury-backed features degrade gracefully to the RPC path.
MERCURY_AUTH_TOKEN=
MERCURY_TESTNET_URL=https://testnet.mercurydata.app/rest
MERCURY_MAINNET_URL=https://mainnet.mercurydata.app/rest

# SoroPad Factory Contract Address
# The on-chain address of the SoroPad factory contract for each network.
# Used by the recent-launches feed to filter events to only tokens that were
# deployed through SoroPad (issue #470). Without this the feed would show
# every token on the network that emits an "init" event.
# Deploy the factory and set its address here:
NEXT_PUBLIC_FACTORY_ADDRESS=

# Token Contract WASM Hashes
# WASM binaries must be deployed separately on each network.
# Upload the token contract WASM to the network:
#   cd contracts && stellar contract build
#   stellar contract upload --wasm target/wasm32-unknown-unknown/release/soroban_token.wasm --network <network> --source <your-identity>
# Then set the returned hash for the corresponding network below:
NEXT_PUBLIC_TOKEN_WASM_HASH_TESTNET=
NEXT_PUBLIC_TOKEN_WASM_HASH_MAINNET=
NEXT_PUBLIC_TOKEN_WASM_HASH_FUTURENET=

# Sponsored Deploys (Fee Sponsorship)
# Secret key of the launchpad sponsor account that pays fee-bump fees.
# Must be a funded Stellar account with enough XLM to cover sponsored fees.
# Never expose this to the client -- server-side only.
SPLLAN_SPONSOR_SECRET=

# Maximum number of sponsored deploys per user address per day.
SPONSOR_DAILY_QUOTA_PER_ADDRESS=1

# Maximum number of sponsored deploys per IP address per day.
SPONSOR_DAILY_QUOTA_PER_IP=5
